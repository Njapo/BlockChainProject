# Copy this file to ".env" and fill in your own values.
# The .env file is gitignored and must never be committed.

# An RPC endpoint for the Sepolia testnet.
# Free options: https://www.alchemy.com, https://infura.io,
# or a public endpoint such as https://rpc.sepolia.org
SEPOLIA_RPC_URL=

# Private key of a throwaway wallet funded with Sepolia test ETH.
# Use a dedicated test wallet only. Never use a key that holds real funds.
PRIVATE_KEY=
